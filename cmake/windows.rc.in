#include <windows.h>
1 ICON "@icon_dir@/helloneedle.ico"
1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Hello Needle\0"
      VALUE "Comments", "Created by Alfredo Llaquet-Alsina. Programmed by ChatGPT.\0"
      VALUE "FileVersion", "@PROJECT_VERSION@\0"
#ifdef HELLO_NEEDLE_LAUNCHER
      VALUE "OriginalFilename", "Hello Needle.exe\0"
#else
      VALUE "OriginalFilename", "helloneedle.exe\0"
#endif
      VALUE "ProductName", "Hello Needle\0"
      VALUE "ProductVersion", "@PROJECT_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
